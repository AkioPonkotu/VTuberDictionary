# Required when the research and verification stages are implemented.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required for YouTube channel metadata and subscriber counts.
YOUTUBE_API_KEY=

# Required for Twitch discovery and metadata.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Non-secret pipeline configuration.
YOUTUBE_MIN_SUBSCRIBERS=10000
TWITCH_MIN_FOLLOWERS=5000
AUDIENCE_THRESHOLD_MODE=any
# Candidate workers (1--128). Agent/API-specific limits remain independent.
PROCESSING_CONCURRENCY=6
# Simultaneous OpenAI requests (1--128), shared by research and verification.
OPENAI_CONCURRENCY=2
# Minimum interval between OpenAI request starts. Use 1.0 for a 200k TPM limit
# when prompts reserve up to about 1,500 tokens; leave 0 for no application pacing.
OPENAI_MIN_REQUEST_INTERVAL_SECONDS=1.0
OPENAI_MAX_OUTPUT_TOKENS=384
OPENAI_RATE_LIMIT_RETRY_SECONDS=900
TWITCH_DISCOVERY_ENABLED=true
TWITCH_DISCOVERY_LANGUAGE=ja
TWITCH_DISCOVERY_TAG=VTuber
TWITCH_DISCOVERY_MAX_PAGES=20

# Crawler-based, no-API-key web lookup for candidates discovered through Twitch.
TWITCH_CRAWLER_ENABLED=true
TWITCH_CRAWLER_MAX_RESULTS=3
TWITCH_CRAWLER_DELAY_SECONDS=1.0
